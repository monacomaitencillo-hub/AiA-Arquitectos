rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function selfDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthed() && selfDoc().disabled == false;
    }

    function isAdmin() {
      return isActive() && selfDoc().role == 'admin';
    }

    function isEditorOrAdmin() {
      return isActive() && selfDoc().role in ['admin', 'editor'];
    }

    // ── Users collection ────────────────────────────────────────────────────
    match /users/{userId} {
      // Any active user can read the users list (needed for access management UI)
      allow read: if isActive();
      // Only admins write; user creation is done via backend (Admin SDK)
      allow write: if isAdmin();
    }

    // ── Sections collection ─────────────────────────────────────────────────
    // Lectura pública: se muestran en la web pública (index.html → "Proyectos"),
    // sin login, así que allowedUids ya no filtra la lectura acá.
    match /sections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Dropbox links collection (Detalles Constructivos / Proyectos con Permiso) ──
    // Lectura pública por el mismo motivo que sections/pages.
    match /dropboxLinks/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Pages collection ────────────────────────────────────────────────────
    // Lectura pública: el contenido de cada página se muestra en la web
    // pública sin login (ver index.html → "Proyectos").
    match /pages/{pageId} {
      function sectionData() {
        return get(/databases/$(database)/documents/sections/$(resource.data.sectionId)).data;
      }
      function newSectionData() {
        return get(/databases/$(database)/documents/sections/$(request.resource.data.sectionId)).data;
      }

      allow read: if true;

      // Admin can do anything; editors can create/update in allowed sections
      allow create: if isAdmin() ||
        (isEditorOrAdmin() && request.auth.uid in newSectionData().allowedUids);

      allow update: if isAdmin() ||
        (isEditorOrAdmin() && request.auth.uid in sectionData().allowedUids);

      allow delete: if isAdmin();
    }

    // ── Config collection (listas compartidas: comunas, revisores,
    // calculistas, encargados de la ficha de Antecedentes) ─────────────────
    match /config/{docId} {
      allow read: if isActive();
      allow write: if isEditorOrAdmin();
    }

    // ── Planos pages (Antecedentes Municipales, Normativas, y cualquier
    // otro ítem 'notes' que se agregue en Planos) ──────────────────────────
    // Notas y archivos por obra, copiados de `pages` pero independientes;
    // parentId distingue a qué ítem de Planos pertenece cada doc.
    // No es público (a diferencia de sections/pages): solo usuarios activos.
    match /planosPages/{pageId} {
      allow read: if isActive();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
